{
	"name": "time-sliced",
	"version": "0.1.1",
	"description": "Run long loops without freezing the event loop: yield on a time budget, not every N items",
	"license": "MIT",
	"author": "Ankur Dubey (https://github.com/RagedPanda)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RagedPanda/time-sliced.git"
	},
	"type": "module",
	"main": "./dist/cjs/index.js",
	"types": "./dist/cjs/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/esm/index.d.ts",
				"default": "./dist/esm/index.js"
			},
			"require": {
				"types": "./dist/cjs/index.d.ts",
				"default": "./dist/cjs/index.js"
			}
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "node -e \"fs.rmSync('dist', {recursive: true, force: true})\" && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.ts",
		"typecheck": "tsc --noEmit",
		"test": "node --test \"test/**/*.test.ts\"",
		"bench": "node bench/index.ts",
		"prepublishOnly": "npm run typecheck && npm test && npm run build"
	},
	"keywords": [
		"event-loop",
		"yield",
		"time-slicing",
		"scheduler",
		"non-blocking",
		"responsive",
		"freeze",
		"jank",
		"long-task",
		"setimmediate",
		"electron",
		"promise",
		"async"
	],
	"devDependencies": {
		"@types/async": "3.2.25",
		"@types/node": "^26.6.5",
		"async": "3.2.6",
		"typescript": "^7.0.2"
	}
}
